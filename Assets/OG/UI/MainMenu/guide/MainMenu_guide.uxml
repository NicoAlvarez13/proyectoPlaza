                        <ui:VisualElement name="btnLeaveAndDeleteRoom" class="pillBtnBack" style="position: absolute; top: 0%; display: flex; margin-top: 48px; height: auto; aspect-ratio: 1; width: 100px; background-color: rgb(161, 3, 0); align-self: center; right: auto; left: 0; margin-left: 48px;">
