                <ui:VisualElement name="CreateRoomContainer" class="codeMainContainer" style="top: -12%; flex-wrap: nowrap; flex-shrink: 0; align-items: center; position: relative; width: 787px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; display: flex; height: auto; background-color: rgba(255, 255, 255, 0); border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px; overflow: hidden; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); border-top-width: 4px; border-right-width: 4px; border-bottom-width: 4px; border-left-width: 4px;">
                    <ui:VisualElement name="DecorativeBlur" style="position: absolute; top: 0; align-self: center; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0); border-top-left-radius: 80px; border-top-right-radius: 80px; border-bottom-right-radius: 80px; border-bottom-left-radius: 80px; filter: blur(20); display: flex; -unity-background-image-tint-color: rgb(255, 255, 255); border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255);"/>
                    <ui:VisualElement name="MainContainer" picking-mode="Ignore" class="codeMainContainer" style="padding-top: 180px; padding-right: 100px; padding-bottom: 100px; padding-left: 100px; top: 0%; flex-wrap: nowrap; flex-shrink: 0; align-items: center; position: relative; translate: 0% 0; background-color: rgba(0, 0, 0, 0.78); border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); border-top-width: 4px; border-right-width: 4px; border-bottom-width: 4px; border-left-width: 4px; width: 787px; border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px;">
                        <ui:VisualElement name="btnGoToReconnectContainer" class="pillBtnBack" style="position: absolute; top: 0%; display: flex; margin-top: 48px; height: auto; aspect-ratio: 1; width: 100px; background-color: rgb(0, 65, 128); align-self: flex-end; margin-right: 48px; right: 0;">
