<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/OG/UI/MainStyles.uss?fileID=7433441132597879392&amp;guid=1dafedb736d06de4c9ee17c43f3cef75&amp;type=3#MainStyles"/>
    <ui:VisualElement name="ViewportContainer" class="viewportContainer">
        <ui:VisualElement name="MenuesContainer" class="menuesContainer" style="translate: 0% 0%; transition-property: translate; transition-duration: 1.2s; transition-timing-function: ease-in-out-sine; display: flex;">
            <ui:VisualElement name="SecondMenuContainer" class="codeMenuContainer" style="top: -3px; left: 0;">
                <ui:Image source="project://database/Assets/Assets/logo3.png?fileID=2800000&amp;guid=aaaf77bdaa1df3a4b9e2c2e0eb1bb92a&amp;type=3#logo3" picking-mode="Ignore" style="top: 0%; align-self: center; position: absolute; width: auto; height: 500px; aspect-ratio: 1;"/>
                <ui:Image source="project://database/Assets/Assets/OG/moon.png?fileID=2800000&amp;guid=833bce275514d9348b073a6670091aba&amp;type=3#moon" style="position: absolute; top: auto; bottom: -82px; left: 1175px;"/>
                <ui:Image source="project://database/Assets/Assets/Personajes/Astronauta.png?fileID=2800000&amp;guid=ac9028ce58647054da6c3e1af0ceb0b3&amp;type=3#Astronauta" name="Astronaut" style="position: absolute; top: auto; bottom: 478px; left: 708px; height: 400px; width: 364px; translate: 0% -1%; aspect-ratio: 1;"/>
                <ui:VisualElement name="JoinRoomContainer" class="codeMainContainerBack" style="height: auto; border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px; border-left-color: rgba(0, 0, 0, 0); border-right-color: rgba(0, 0, 0, 0); border-top-color: rgba(0, 0, 0, 0); border-bottom-color: rgba(0, 0, 0, 0); overflow: hidden; top: 21%;">
                    <ui:VisualElement name="BlurEffect" style="position: absolute; top: 0; align-self: center; width: 100%; height: 100%; background-color: rgb(0, 0, 0); border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px; filter: blur(10); display: flex; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0);"/>
                    <ui:VisualElement name="CodeMainContainer" class="codeMainContainer" style="padding-top: 100px; padding-right: 80px; padding-bottom: 160px; padding-left: 80px; height: 100%; position: relative; top: 0%; background-color: rgba(0, 59, 108, 0); border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); border-top-width: 4px; border-right-width: 4px; border-bottom-width: 4px; border-left-width: 4px; border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px;">
                        <ui:Label text="Ingresar el codigo de la sala" style="height: auto; font-size: 74px; color: rgb(255, 255, 255); -unity-text-align: upper-center; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Examples%20&amp;%20Extras/Fonts/Electronic%20Highway%20Sign.TTF?fileID=12800000&amp;guid=8a2b9e2a607dd2143b58c44bc32410b4&amp;type=3#Electronic Highway Sign&quot;); -unity-font-style: normal; white-space: normal; text-overflow: clip; align-self: center; padding-top: 44px; padding-right: 44px; padding-bottom: 44px; padding-left: 44px; -unity-text-outline-color: rgb(255, 255, 255); -unity-text-outline-width: 1px; width: 599px;"/>
                        <ui:TextField label="" placeholder-text="Codigo..." picking-mode="Position" readonly="false" keyboard-type="OneTimeCode" hide-placeholder-on-focus="false" vertical-scroller-visibility="Auto" enabled="true" tabindex="1" max-length="4" name="CodeInput" style="position: relative; align-self: center; width: 517px; height: 88px; font-size: 60px; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Examples%20&amp;%20Extras/Fonts/Electronic%20Highway%20Sign.TTF?fileID=12800000&amp;guid=8a2b9e2a607dd2143b58c44bc32410b4&amp;type=3#Electronic Highway Sign&quot;); margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; border-top-left-radius: 44px; border-top-right-radius: 44px; border-bottom-right-radius: 44px; border-bottom-left-radius: 44px; -unity-background-image-tint-color: rgb(255, 255, 255);"/>
                        <ui:VisualElement class="pillBtnBack" style="position: relative; top: 0%; margin-top: 120px; background-color: rgb(14, 128, 0); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px;">
                            <ui:Button text="Unirse" enabled="true" name="JoinButton" class="pillBtn" style="position: absolute; background-color: rgb(191, 255, 61); color: rgb(93, 140, 0); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px;"/>
                        </ui:VisualElement>
                        <ui:Label text="ERROR!" name="lblErrorMessage" style="height: 149px; font-size: 32px; color: rgb(255, 73, 73); -unity-text-align: middle-center; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Examples%20&amp;%20Extras/Fonts/Electronic%20Highway%20Sign.TTF?fileID=12800000&amp;guid=8a2b9e2a607dd2143b58c44bc32410b4&amp;type=3#Electronic Highway Sign&quot;); -unity-font-style: bold; white-space: normal; text-overflow: clip; align-self: center; -unity-text-outline-color: rgb(255, 255, 255); -unity-text-outline-width: 0; width: 100%; position: absolute; bottom: 0;"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="btnReconnect" class="pillBtnBack" style="position: absolute; top: 0%; display: flex; margin-top: 48px; height: auto; aspect-ratio: 1; width: 100px; background-color: rgb(0, 156, 202); align-self: flex-end; margin-right: 48px; right: 0;">
                        <ui:Button text="" enabled="true" name="Button" icon-image="" class="pillBtn unity-button__image" style="position: absolute; background-color: rgb(59, 193, 255);">
                            <ui:Image source="project://database/Assets/OG/sprites/reconnect.png?fileID=2800000&amp;guid=c40753c68c715b84f83fb93877b4b133&amp;type=3#reconnect" scale-mode="ScaleToFit" tint-color="rgb(0, 89, 115)" picking-mode="Ignore" style="height: 100%; width: auto; align-self: center; aspect-ratio: 1;"/>
                        </ui:Button>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement focusable="false" name="MainMenuContainer" class="mainMenuContainer">
                <ui:Image source="project://database/Assets/Assets/OG/title.png?fileID=2800000&amp;guid=c8734b44d545f704b89b9876f3cdb53d&amp;type=3#title" name="MainTitle" class="pctMainTitle"/>
                <ui:VisualElement enabled="true" picking-mode="Ignore" name="PlayButtonBack" class="pillBtnBack" style="display: flex;">
                    <ui:Button text="JUGAR" enabled="true" focusable="true" name="PlayButton" class="pillBtn"/>
                </ui:VisualElement>
                <ui:Image source="project://database/Assets/Assets/OG/render.png?fileID=2800000&amp;guid=6ee74436680c71e49894d3a7d9cc8cf6&amp;type=3#render" name="PlazaRender" focusable="false" enabled="true" picking-mode="Ignore" class="plazaRender" style="position: absolute; bottom: -27.5%; height: 100%;"/>
            </ui:VisualElement>
            <ui:Image source="project://database/Assets/Assets/OG/Clouds.png?fileID=2800000&amp;guid=6eea1578675083141be568ecdfc7ec07&amp;type=3#Clouds" name="Clouds" enabled="true" class="clouds" style="translate: 0% 0%; display: none;"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="PanelDatos" style="width: 100%; height: 100%; position: absolute; overflow: visible; align-self: center; display: none; flex-grow: 1; flex-shrink: 0; align-items: center; justify-content: center; background-color: rgba(38, 50, 65, 0);">
        <ui:VisualElement name="ContainerFluid" style="flex-grow: 1; width: 100%; height: 100%; align-items: center; justify-content: center; max-width: 2048px; align-self: center;">
            <ui:VisualElement name="BotonesBanderas" style="flex-grow: 1; background-size: 100% 100%; width: 80%; height: auto; position: absolute; justify-content: center; align-self: center; align-content: auto; flex-direction: column; align-items: center; top: 35%;">
                <ui:Button text="" icon-image="" name="BanderEsp" style="width: 436px; background-color: rgba(188, 188, 188, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; background-image: url(&quot;project://database/Assets/Assets/Banderas/Espa%C3%B1aFlag.png?fileID=2800000&amp;guid=0ce0ed82b78336243a64ccc68f7b88d8&amp;type=3#EspañaFlag&quot;); -unity-background-scale-mode: scale-and-crop; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; height: 356px; background-size: cover; flex-direction: row;"/>
                <ui:Button text="" icon-image="" name="BanderaEng" style="width: 436px; background-color: rgba(188, 188, 188, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; background-image: url(&quot;project://database/Assets/Assets/Banderas/BanderaENG.png?fileID=2800000&amp;guid=490a168da7ec19342bf40ee0bd28c1f7&amp;type=3#BanderaENG&quot;); -unity-background-scale-mode: scale-and-crop; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 50px; margin-right: 0; margin-bottom: 0; margin-left: 0; height: 356px; background-size: cover;"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
